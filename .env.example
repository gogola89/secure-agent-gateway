# Copy to .env and adjust if needed. No real secrets belong here -
# this whole project runs on mock data and local-only keys.

# --- Banking API ---
DATABASE_URL=postgresql+psycopg://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# RS256 key pair, generated locally by scripts/gen_keys.py (gitignored).
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ISSUER=mock-idp
JWT_AUDIENCE=banking-api
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Mock IdP credentials (demo only - stands in for a real identity provider).
DEMO_CUSTOMER_PASSWORD=demo-password
AGENT_ASSISTANT_V1_CLIENT_ID=assistant-v1
AGENT_ASSISTANT_V1_CLIENT_SECRET=assistant-v1-secret
AGENT_ASSISTANT_V1_SCOPES="accounts:read transactions:read transfers:initiate products:read"

ADMIN_TOKEN=local-admin-token

# Business rules
TRANSFER_MAX_AMOUNT_CENTS=10000000
TRANSFER_DAILY_LIMIT_CENTS=15000000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Rate limiting
RATE_LIMIT_READS_PER_MINUTE=30
RATE_LIMIT_TRANSFERS_PER_MINUTE=5

SMS_OUTBOX_PATH=var/sms_outbox.log

# --- MCP server ---
BANKING_API_URL=http://localhost:8000
AGENT_CLIENT_ID=assistant-v1
AGENT_CLIENT_SECRET=assistant-v1-secret
CUSTOMER_TOKEN=
